# diagrams/, presentations/, scripts/.
/.local/

# Backstop: any stray scratch planning markdown left at repo root (move it to .local/)
/*_PLAN.md

# Local website dev/debug helper scripts (not part of the site build)
website/scripts/

# Generated from /CHANGELOG.md by website/sync-changelog.mjs (prestart/prebuild)
website/docs/changelog.md

# Generated test reports
tests/TEST_REPORT.md

# Original nested directory (kept locally)
lakets/

# Build output
dist/

