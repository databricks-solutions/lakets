{
  "dashboard": {
    "title": "LakeTS Overview",
    "description": "Operational overview of LakeTS time series toolkit on Lakebase",
    "tags": ["lakets", "timeseries", "lakebase"],
    "timezone": "utc",
    "refresh": "30s",
    "panels": [
      {
        "title": "Hypertable Count",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "targets": [{
          "rawSql": "SELECT metric_value FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_hypertables_total'",
          "format": "table"
        }]
      },
      {
        "title": "Database Size",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "fieldConfig": { "defaults": { "unit": "decbytes" } },
        "targets": [{
          "rawSql": "SELECT metric_value FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_database_size_bytes'",
          "format": "table"
        }]
      },
      {
        "title": "Active Chunks",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "targets": [{
          "rawSql": "SELECT metric_value FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_chunks_total' AND labels->>'status' = 'active'",
          "format": "table"
        }]
      },
      {
        "title": "Compressed Chunks",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
        "targets": [{
          "rawSql": "SELECT COALESCE(metric_value, 0) FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_chunks_total' AND labels->>'status' = 'compressed'",
          "format": "table"
        }]
      },
      {
        "title": "Chunks by Status",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
        "targets": [{
          "rawSql": "SELECT labels->>'status' as status, metric_value as count FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_chunks_total'",
          "format": "table"
        }]
      },
      {
        "title": "Chunk Health by Hypertable",
        "type": "table",
        "gridPos": { "h": 8, "w": 16, "x": 8, "y": 4 },
        "targets": [{
          "rawSql": "SELECT * FROM lakets.chunk_health()",
          "format": "table"
        }]
      },
      {
        "title": "Continuous Aggregate Lag (seconds)",
        "type": "bargauge",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
        "targets": [{
          "rawSql": "SELECT labels->>'aggregate' as name, metric_value as lag_seconds FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_cagg_lag_seconds'",
          "format": "table"
        }]
      },
      {
        "title": "Policies",
        "type": "table",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
        "targets": [{
          "rawSql": "SELECT labels->>'type' as policy_type, metric_value as count FROM lakets.lakets_metrics() WHERE metric_name = 'lakets_policies_total'",
          "format": "table"
        }]
      },
      {
        "title": "Top Queries by Total Time",
        "type": "table",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
        "targets": [{
          "rawSql": "SELECT * FROM lakets.query_stats(10)",
          "format": "table"
        }]
      }
    ],
    "templating": {
      "list": []
    }
  },
  "overwrite": true,
  "__inputs": [{
    "name": "DS_POSTGRESQL",
    "label": "PostgreSQL",
    "description": "Lakebase PostgreSQL data source",
    "type": "datasource",
    "pluginId": "postgres"
  }]
}
